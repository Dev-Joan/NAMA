# Local environment for the NAMA Polyclinic website.
# Copy this file to `.env` and fill in the values: cp .env.example .env
# On Cloudflare Pages, set the same variables under
# Settings → Variables and Secrets (for Production and Preview).

# Web3Forms access key for the contact form ("Dites bonjour à NAMA").
# Get one free at https://web3forms.com with the clinic's email address;
# messages are emailed there. The key is public by design (it can only send
# to that one address). Without it, the form shows its error message.
VITE_WEB3FORMS_KEY=

# Public address of the live site, e.g. https://www.namapolyclinic.com.
# Read at build time for the canonical URL, the share image (og:image),
# sitemap.xml and robots.txt. If empty, the build still works but leaves
# out the canonical URL and the sitemap.
SITE_URL=
