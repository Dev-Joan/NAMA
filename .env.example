# Local environment for NAMA Polyclinic.
#
# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
#
# The website reads VITE_* values from .env by itself. Everything else
# (SITE_URL, DATABASE_URL, ...) must be exported into your shell first:
#   set -a; source .env; set +a

# --- Database (API server and lib/db only; the website does not need it) ----
# Required by artifacts/api-server, lib/db, and `pnpm --filter @workspace/db run push`.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Homebrew Postgres usually uses your macOS username with no password, e.g.
#   postgres://YOUR_MAC_USERNAME@localhost:5432/nama
# (create the database first with: createdb nama)
DATABASE_URL=

# --- API server (artifacts/api-server) ---------------------------------------
# Logging verbosity: trace | debug | info | warn | error | fatal. Defaults to info.
LOG_LEVEL=info

# development enables pretty logs; production switches to JSON logs.
NODE_ENV=development

# --- Website (artifacts/nama-polyclinic) ------------------------------------
# Public address of the live site, read at build time. Used for the canonical
# URL, the share image (og:image / twitter:image), sitemap.xml and robots.txt.
# If empty, the build still works but leaves out the canonical URL and sitemap.
SITE_URL=

# Web3Forms access key for the contact form ("Dites bonjour à NAMA").
# Get one free at https://web3forms.com by entering the clinic's email address;
# messages are emailed there. The key is public by design (it only sends to
# that one address). Without it, the form shows its error message.
VITE_WEB3FORMS_KEY=

# --- Per-app settings: set these on the command line, not here --------------
# PORT and BASE_PATH are required by both Vite apps (nama-polyclinic,
# mockup-sandbox), and PORT by the API server. Each app needs its own PORT,
# so pass them per command instead of sharing one value:
#
#   PORT=5173 BASE_PATH=/ pnpm --filter @workspace/nama-polyclinic run dev
#   PORT=5174 BASE_PATH=/ pnpm --filter @workspace/mockup-sandbox run dev
#   PORT=5000 pnpm --filter @workspace/api-server run dev
#
# REPL_ID is set by Replit only. Leave it unset locally; it just turns on
# Replit-specific Vite plugins.
